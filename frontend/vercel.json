{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "nodeVersion": "18.x",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aeon-c8zq.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}